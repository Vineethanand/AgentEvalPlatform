# Copy to .env and fill in the keys you have. You need at least one provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Gateway admin key (any random string starting with sk-). Workers use it to
# mint a per-trial key and read back each trial's token usage and spend.
LITELLM_MASTER_KEY=sk-change-me

# Shared secret between workers and the API's internal endpoints.
INTERNAL_TOKEN=change-me-too

# Model used by the LLM judge (an alias from gateway/litellm_config.yaml).
JUDGE_MODEL=gpt-judge
